FROM ubuntu:22.04
COPY --from=elyterminal-release /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ARG TEST_UID=1000
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list \
 && apt-get update -o APT::Update::Error-Mode=any -o Acquire::Retries=3 \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends -o Acquire::Retries=3 \
    ca-certificates desktop-file-utils file git curl xdg-utils python3 python3-pil \
    xvfb xauth x11-utils x11-apps dbus-x11 libgl1-mesa-dri mesa-vulkan-drivers \
    libxkbcommon0 libxkbcommon-x11-0 libxcb1 libwayland-client0 libwayland-egl1 \
    libegl1 libvulkan1 fonts-noto-cjk \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid "$TEST_UID" ci
